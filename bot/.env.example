# ============================================================
#  Настройки бота. Скопируйте этот файл в .env и заполните:
#    copy .env.example .env
# ============================================================

# Город, для которого показывать погоду (используется, если не заданы координаты)
CITY=Москва

# Либо точные координаты (приоритетнее, чем CITY).
# Пример для Москвы: LAT=55.7558, LON=37.6173
# LAT=55.7558
# LON=37.6173

# ID вашей группы ВКонтакте (только цифры, без минуса и пробелов).
# Где посмотреть: Управление сообществом -> Адрес; например vk.com/club123456789 -> 123456789
VK_GROUP_ID=

# Ключ доступа сообщества с правом «Работа со стеной» (wall).
# Как получить: Управление -> Работа с API -> Ключи доступа -> Создать новый
VK_TOKEN=

# Расписание публикации в формате cron (минута час день месяц день_недели).
# По умолчанию — каждый день в 08:00. Примеры:
#   0 8 * * *    — каждый день в 08:00
#   30 7 * * *   — каждый день в 07:30
#   0 8,20 * * * — в 08:00 и в 20:00
CRON=0 8 * * *

# Часовой пояс расписания (по умолчанию — часовой пояс компьютера).
# Примеры: Europe/Moscow, Asia/Novosibirsk, Asia/Vladivostok
# TZ_NAME=Europe/Moscow

# ============================================================
#  Бот для ВТОРОЙ группы (при необходимости) — суффикс _2.
#  Аналогично поддерживаются боты 3, 4, 5 (суффиксы _3, _4, _5).
# ============================================================
# CITY_2=Казань
# VK_GROUP_ID_2=987654321
# VK_TOKEN_2=
